  "\"matlabVersion\":\"synthetic verifier fixture, not runtime evidence\","
  "\"sourceRevision\":\"${revision}\",\"caseName\":\"${case_name}\","
  "\"source\":\"examples/matlab/invocation_context.m\","
  "\"sourceSnapshot\":\"${snapshot}\"}")
