file(READ "${SOURCE_DIR}/tests/reference/matlab/output-semantics-contract.json" contract)
string(JSON cases GET "${contract}" cases)
list(LENGTH names case_count)
math(EXPR last "${case_count} - 1")
foreach(index RANGE 0 ${last})
  string(JSON message GET "${cases}" ${index} exceptionMessageContains)
  string(JSON succeeded GET "${cases}" ${index} succeeded)
  if(NOT succeeded)
    string(APPEND message " Synthetic verifier fixture; not a MATLAB execution.")
  endif()
  string(REPLACE "\\" "\\\\" message "${message}")
  string(REPLACE "\"" "\\\"" message "${message}")
  string(JSON cases REMOVE "${cases}" ${index} exceptionMessageContains)
  string(JSON cases SET "${cases}" ${index} exceptionMessage "\"${message}\"")
endforeach()
